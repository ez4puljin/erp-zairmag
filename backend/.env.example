# backend/.env — жишээ. Хуулж аваад .env нэрээр хадгална.
# .env файлыг git-д ХЭЗЭЭ Ч оруулахгүй (.gitignore-д орсон).

# ---- Database ----
# Локал:
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/icecream_erp?schema=public"
# Render дээр энэ утгыг Render өөрөө өгнө (render.yaml → fromDatabase).

# ---- JWT ----
# Үүсгэх (PowerShell): [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
JWT_SECRET="random-64-char-string-here"
JWT_REFRESH_SECRET="another-random-64-char-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ---- Server ----
PORT=3000
NODE_ENV="development"

# ---- CORS ----
# Локал сүлжээ (192.168.x.x, 10.x.x.x) болон Tailscale автоматаар зөвшөөрөгддөг.
# Үүлэн орчинд admin-ы домэйнийг таслалаар тусгаарлаж бичнэ.
# `*.` эхэлсэн загвар нь дэд домэйныг бүгдийг зөвшөөрнө (Vercel preview-д хэрэгтэй).
# Ж: CORS_ORIGINS="https://zairmag-erp.vercel.app,*.vercel.app"
CORS_ORIGINS=""

# ---- Файл байршуулалт ----
# Хоосон бол төслийн uploads/ хавтас руу бичнэ.
# Render дээр байнгын дискний зам: /var/data/uploads
UPLOADS_DIR=""
